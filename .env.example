# ローカル開発用。実際の値は .env に書く（.gitignore 済み）
#
# 本番の値は Secret Manager / Vercel 環境変数 に置く（インフラ設計 §10）。
# Terraform state にシークレットを入れない（ADR-0012）。

# --- DB（compose.yaml の設定と一致させる）---
DATABASE_URL=postgres://physique:dev@localhost:5432/physique?sslmode=disable

# --- API ---
PORT=8080
ENV=local

# --- Supabase（ローカルでは認証をスキップする場合は空でよい）---
SUPABASE_URL=
SUPABASE_JWKS_URL=

# --- Cloudflare R2（写真。ローカルでは未設定でよい）---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Sentry（ローカルでは送信しない）---
SENTRY_DSN=
