<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ja</string>
	<key>CFBundleDisplayName</key>
	<string>Physique</string>
	<!-- HealthKit の利用目的（要件 B-01 / B-09）。
	     **読み取りのみ。** 書き込みの権限は要求しない -->
	<key>NSHealthShareUsageDescription</key>
	<string>体重・体脂肪率・歩数・睡眠を読み取り、TDEE の推定と回復の判定に使います。Apple Health への書き込みは行いません。</string>
	<!-- 位置情報の利用目的（要件 N-08）。
	     **端末内だけで使う。** 緯度経度はサーバに送らない（docs/01-要件定義.md §4-C）。
	     「近い順に並べる」を押したときだけ聞く -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>よく行く店で食べたものを一覧の上に出すために、いまいる場所を使います。場所はこの iPhone の中だけに保存し、サーバには送りません。</string>
	<!-- 接続先と鍵。**ビルド設定（xcconfig / Build Settings）から差し込む。**
	     ここに実値を書くと public リポジトリに入る。
	     未設定のまま実機に入れると localhost を叩いて通信できない -->
	<key>API_BASE_URL</key>
	<string>$(API_BASE_URL)</string>
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<!-- 公開前提の鍵。単体では何も読めない（DB は RLS で閉じている） -->
	<key>SUPABASE_ANON_KEY</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
